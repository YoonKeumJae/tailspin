---
import type { Category, Publisher } from '../types/game';

interface Props {
    categories: Category[];
    publishers: Publisher[];
}

const { categories, publishers } = Astro.props;
---

<form
    class="mb-8 bg-slate-800/60 rounded-xl border border-slate-700/50 p-6 space-y-5"
    data-testid="game-filters"
    aria-label="Filter games"
>
    <fieldset>
        <legend class="text-sm font-medium text-slate-300 mb-3">Categories</legend>
        <div class="flex flex-wrap gap-3">
            {categories.map((category) => (
                <label class="inline-flex items-center gap-2 rounded-lg border border-slate-600 bg-slate-900/50 px-3 py-2 text-sm text-slate-200 cursor-pointer hover:border-blue-500/50 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-600/20 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-blue-500">
                    <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 rounded border-slate-500 bg-slate-800 accent-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                        data-testid={`filter-category-${category.id}`}
                    />
                    {category.name}
                </label>
            ))}
        </div>
    </fieldset>

    <div class="flex flex-col sm:flex-row sm:items-end gap-4">
        <div class="flex flex-col gap-2">
            <label for="filter-publisher" class="text-sm font-medium text-slate-300">Publisher</label>
            <select
                id="filter-publisher"
                name="publisher"
                class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="filter-publisher"
            >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                ))}
            </select>
        </div>
        <button
            type="reset"
            class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none transition-colors"
            data-testid="filter-clear"
        >
            Clear filters
        </button>
    </div>

    <p class="text-sm text-slate-400" role="status" aria-live="polite" data-testid="filter-result-count"></p>
</form>

<script>
    const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-game-item]'));
    const noResults = document.querySelector<HTMLElement>('[data-testid="no-results"]');
    const count = form?.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
    const checkboxes = Array.from(form?.querySelectorAll<HTMLInputElement>('input[name="category"]') ?? []);
    const publisher = form?.querySelector<HTMLSelectElement>('select[name="publisher"]');

    /**
     * Shows only the games matching the selected categories (OR) and publisher (AND),
     * then updates the empty state, result count, and URL query string.
     */
    function applyFilters(): void {
        const categoryIds = checkboxes.filter((c) => c.checked).map((c) => c.value);
        const publisherId = publisher?.value ?? '';
        let visible = 0;
        for (const item of items) {
            const match =
                (categoryIds.length === 0 || categoryIds.includes(item.dataset.categoryId ?? '')) &&
                (publisherId === '' || item.dataset.publisherId === publisherId);
            item.hidden = !match;
            if (match) visible++;
        }
        if (noResults) noResults.hidden = visible > 0;
        if (count) count.textContent = `Showing ${visible} of ${items.length} games`;

        const params = new URLSearchParams();
        categoryIds.forEach((id) => params.append('category', id));
        if (publisherId) params.set('publisher', publisherId);
        const query = params.toString();
        history.replaceState(null, '', query ? `?${query}` : location.pathname);
    }

    /** Restores the checkbox and select state from the URL query string. */
    function restoreFromUrl(): void {
        const params = new URLSearchParams(location.search);
        const selected = params.getAll('category');
        checkboxes.forEach((c) => (c.checked = selected.includes(c.value)));
        const pub = params.get('publisher');
        if (publisher && pub && Array.from(publisher.options).some((o) => o.value === pub)) {
            publisher.value = pub;
        }
    }

    if (form) {
        restoreFromUrl();
        form.addEventListener('change', applyFilters);
        form.addEventListener('submit', (e) => e.preventDefault());
        // Run after the reset has updated the controls.
        form.addEventListener('reset', () => setTimeout(applyFilters));
        applyFilters();
    }
</script>
